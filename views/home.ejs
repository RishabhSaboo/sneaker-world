<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shopping Cart</title>

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      body {
        background: 
      linear-gradient(135deg, rgba(44, 62, 80, 0.75), rgba(52, 73, 94, 0.75)),
      url("https://images.unsplash.com/photo-1519744792095-2f2205e87b6f?auto=format&fit=crop&w=1600&q=80");
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    color: #ecf0f1;
    font-family: "Segoe UI", sans-serif;
      }

      .navbar {
        background: rgba(0, 0, 0, 0.4) !important;
        backdrop-filter: blur(6px);
      }

      .hero {
        padding: 120px 20px;
        text-align: center;
      }

      .hero h1 {
        font-size: 3.5rem;
        font-weight: 700;
      }

      .hero p {
        font-size: 1.25rem;
        margin-top: 15px;
        opacity: 0.9;
      }

      .btn-custom {
        background-color: #ffffff;
        color: #2c3e50;
        font-weight: 600;
        border-radius: 50px;
        padding: 10px 25px;
        margin-top: 20px;
        transition: 0.3s;
      }

      .btn-custom:hover {
        background-color: #dfe6e9;
      }

      footer {
        margin-top: 100px;
        padding: 20px 0;
        text-align: center;
        opacity: 0.7;
        font-size: 0.9rem;
      }
    </style>
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark py-3">
      <div class="container">
        <a class="navbar-brand fs-3 fw-bold" href="#">Sneaker World</a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link active" href="#">Home</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/products">Products</a>
            </li>

            <% if(!currentUser) { %>
            <li class="nav-item">
              <a class="nav-link" href="/login">Login</a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/register">Register</a>
            </li>
            <% } else { %>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <h1>Welcome to Your Shopping Experience</h1>
        <p>
          Discover amazing products, share your own, and join the community!
          <br />
          Enjoy a seamless and modern shopping experience.
        </p>

        <a href="/products" class="btn btn-custom">Browse Products</a>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <p>All Rights Reserved &copy; 2024</p>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
